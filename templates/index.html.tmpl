  <form method="dialog"><h2 id="citation-heading">BibTeX citation</h2><button class="dialog-close" aria-label="Close citation" value="close">×</button></form>
  <p id="citation-instructions">Clipboard access is unavailable. Select and copy the citation below.</p>
  <label class="sr-only" for="citation-text">BibTeX</label><textarea id="citation-text" readonly rows="12" spellcheck="false"></textarea>
</dialog>
