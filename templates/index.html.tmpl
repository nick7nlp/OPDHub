<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Search papers on on-policy distillation for language models.">
  <title>OPDHub — Paper Search</title>
  <link rel="icon" type="image/png" href="static/images/opd-overview.png">
  <link rel="stylesheet" href="static/css/style.css?v={{ASSET_VERSION}}">
</head>
<body>
<header class="search-header">
  <div class="container header-inner">
    <h1><a class="wordmark" href="./"><span>OPD</span>Hub</a></h1>
    <nav aria-label="Project links">
      <a href="https://arxiv.org/abs/2604.00626" target="_blank" rel="noopener">Survey</a>
      <a href="https://github.com/nick7nlp/Awesome-LLM-On-Policy-Distillation" target="_blank" rel="noopener">Reading list</a>
    </nav>
  </div>
</header>
<main class="container search-main">
  <div class="search-wrap">
    <label class="sr-only" for="search-input">Search papers</label>
    <input id="search-input" type="search" placeholder="Search title, author, method, or paper ID…" autocomplete="off" autofocus>
  </div>
  <div class="search-toolbar">
    <span id="visible-count" class="search-count" role="status" aria-live="polite">{{PAPER_COUNT}} papers</span>
    <div class="search-actions">
      <button id="clear-filters" type="button" class="clear-btn">Clear</button>
      <button id="export-bibtex" type="button" class="export-btn">Export BibTeX</button>
    </div>
  </div>
  <details class="filter-panel">
    <summary>Filters</summary>
    <div class="filter-grid">
      <div class="filter-row">
        <span class="filter-label">Topic</span>
        <div class="filter-chips" data-filter-group="section">{{FILTER_SECTIONS}}</div>
      </div>
      <div class="filter-row">
        <span class="filter-label">Mechanism</span>
        <div class="filter-chips" data-filter-group="mechanism">{{FILTER_MECHANISMS}}</div>
      </div>
      <div class="filter-row">
        <span class="filter-label">Year</span>
        <div class="filter-chips" data-filter-group="year">{{FILTER_YEARS}}</div>
      </div>
    </div>
  </details>
  <div id="paper-list">{{PAPER_LIST}}</div>
  <div id="empty-state" class="empty-state is-hidden">No papers match your search.</div>
</main>
<footer class="site-footer">
  <a href="https://github.com/eliahuhorwitz/Academic-project-page-template" target="_blank" rel="noopener">Template credits</a>
  · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>
</footer>
<script src="static/js/fuse.min.js"></script>
<script src="static/js/search.js?v={{ASSET_VERSION}}"></script>
</body>
</html>
